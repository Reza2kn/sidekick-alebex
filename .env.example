# Copy to .env.local. Keep all credentials and generated values private.
# lib/config.mjs reads literal KEY=value lines; leave values unquoted.
PORT=4317
PUBLIC_BASE_URL=
DEMO_ACCESS_TOKEN=

# Your Alebex account key and the main agent created in your account.
ALEBEX_API_KEY=
ALEBEX_AGENT_ID=
ALEBEX_API_URL=https://api.alebex.ai/api/v1
ALEBEX_ENGINE_URL=https://api.voice.alebex.ai
# configure-agents.mjs creates/reuses the caller and signed webhook below.
ALEBEX_CALLER_AGENT_ID=
ALEBEX_WEBHOOK_SECRET=

# Camera vision and signed call-report interpretation use OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_BROWSER_MODEL=google/gemini-3.5-flash-lite

# Browser proposals and checkout evidence use OpenAI in this version.
OPENAI_API_KEY=
BROWSER_ORDER_PROVIDER=openai
OPENAI_BROWSER_MODEL=gpt-6-luna
OPENAI_BROWSER_TIMEOUT_MS=20000
OPENAI_BROWSER_MAX_OUTPUT_TOKENS=1200
# Optional: Decisions is used only when an explicit next_goal is supplied.
OPENAI_BROWSER_USE_DECISIONS=true

# Published demo uses an active Codex operator and a connected Chrome profile.
BROWSER_ORDER_OPERATOR=true
PROFILE_BROWSER_REQUIRED=true
# build-profile-extension.mjs generates this token if it is blank.
PROFILE_PAIR_TOKEN=

# Optional outbound phone extension. Disabled for the current trial account.
TWILIO_CALLER_VERIFIED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEMO_HUMAN_PHONE=
